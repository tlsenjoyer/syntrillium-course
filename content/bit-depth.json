  "utterances": [
    {
      "id": "2306",
      "segment_ids": [
        "2306",
        "2312"
      ],
      "russian": "Разрешение оцифрованного звука зависит не только от числа отсчётов в секунду, но и от точности представления амплитуды каждого отсчёта.",
      "visual_cues": [
        {
          "segment_id": "2306"
        },
        {
          "segment_id": "2312",
          "anchor": "но и от точности представления амплитуды каждого отсчёта."
        }
      ]
    },
    {
      "id": "2318",
      "segment_ids": [
        "2318"
      ],
      "russian": "Разрешение по амплитуде называют разрядностью.",
      "visual_cues": [
        {
          "segment_id": "2318"
        }
      ]
    },
    {
      "id": "2324",
      "segment_ids": [
        "2324"
      ],
      "russian": "Бит — это компьютерный термин: одна двоичная цифра, которая может принимать значение ноль или один.",
      "visual_cues": [
        {
          "segment_id": "2324"
        }
      ]
    },
    {
      "id": "2330",
      "segment_ids": [
        "2330"
      ],
      "russian": "Один бит может представлять два состояния, например «включено» и «выключено».",
      "visual_cues": [
        {
          "segment_id": "2330"
        }
      ]
    },
    {
      "id": "2336",
      "segment_ids": [
        "2336",
        "2342"
      ],
      "russian": "Два бита вместе могут представлять четыре разных состояния. Это сочетания: ноль-ноль, один-ноль, ноль-один и один-один.",
      "visual_cues": [
        {
          "segment_id": "2336"
        },
        {
          "segment_id": "2342",
          "anchor": "Это сочетания: ноль-ноль, один-ноль, ноль-один и один-один."
        }
      ]
    },
    {
      "id": "2348",
      "segment_ids": [
        "2348",
        "2354"
      ],
      "russian": "Каждый дополнительный бит удваивает число возможных состояний. Поэтому третий бит позволяет представить восемь состояний, четвёртый — шестнадцать, и так далее.",
      "visual_cues": [
        {
          "segment_id": "2348"
        },
        {
          "segment_id": "2354",
          "anchor": "Поэтому третий бит позволяет представить восемь состояний, четвёртый — шестнадцать, и так далее."
        }
      ]
    },
    {
      "id": "2360",
      "segment_ids": [
        "2360"
      ],
      "russian": "Разрешение по амплитуде так же важно, как и частота дискретизации.",
      "visual_cues": [
        {
          "segment_id": "2360"
        }
      ]
    },
    {
      "id": "2366",
      "segment_ids": [
        "2366"
      ],
      "russian": "При дискретизации звуковой волны каждому отсчёту присваивается значение амплитуды, ближайшее к исходной аналоговой волне.",
      "visual_cues": [
        {
          "segment_id": "2366"
        }
      ]
    },
    {
      "id": "2372",
      "segment_ids": [
        "2372"
      ],
      "russian": "При разрядности два бита каждый отсчёт может занимать лишь одно из четырёх возможных положений по амплитуде.",
      "visual_cues": [
        {
          "segment_id": "2372"
        }
      ]
    },
    {
      "id": "2378",
      "segment_ids": [
        "2378"
      ],
      "russian": "При разрядности три бита каждый отсчёт имеет восемь возможных значений амплитуды.",
      "visual_cues": [
        {
          "segment_id": "2378"
        }
      ]
    },
    {
      "id": "2390",
      "segment_ids": [
        "2390"
      ],
      "russian": "Чем выше разрядность, тем ниже уровень шума и выше точность воспроизведения.",
      "visual_cues": [
        {
          "segment_id": "2390"
        }
      ]
    },
    {
      "id": "2396",
      "segment_ids": [
        "2396",
        "2402"
      ],
      "russian": "Звук качества компакт-диска имеет разрядность шестнадцать бит, то есть каждый отсчёт может принимать одно из шестидесяти пяти тысяч пятисот тридцати шести значений амплитуды.",
      "visual_cues": [
        {
          "segment_id": "2396"
        },
        {
          "segment_id": "2402",
          "anchor": "то есть каждый отсчёт может принимать одно из шестидесяти пяти тысяч пятисот тридцати шести значений амплитуды."
        }
      ]
    },
    {
      "id": "2408",
      "segment_ids": [
        "2408",
        "2414"
      ],
      "russian": "Звук качества DVD имеет разрядность двадцать четыре бита, то есть каждый отсчёт может принимать одно из шестнадцати миллионов семисот семидесяти семи тысяч двухсот шестнадцати значений амплитуды.",
      "visual_cues": [
        {
          "segment_id": "2408"
        },
        {
          "segment_id": "2414",
          "anchor": "то есть каждый отсчёт может принимать одно из шестнадцати миллионов семисот семидесяти семи тысяч двухсот шестнадцати значений амплитуды."
        }
      ]
    }
